# Frontend environment (Vite). Copy to .env.local to override.
# EVERYTHING here is OPTIONAL — the app runs with no .env.local at all, because
# the Xano workspace defaults are baked into the code (see src/api/xanoClient.js).
# The document pipeline (/documents, /advisor) works out of the box in mock mode.

# --- Document pipeline: Xano (all have working defaults) -----------------------
# VITE_XANO_BASE_URL=https://xgnh-6ozi-vxez.n7e.xano.io   # Xano instance origin
# VITE_XANO_AUTH_CANON=_WAlCa0m                            # auth API group id
# VITE_XANO_DOCS_CANON=PyL7dgs4                            # documents API group id

# --- Nutrient DWS Viewer (optional; the review surface) -----------------------
# CLIENT-SAFE publishable key (not the secret Data Extraction key). Generate in
# the Nutrient dashboard: Viewer API -> "Generate publishable key".
VITE_NUTRIENT_VIEWER_KEY=

# --- FastAPI sidecar (only for the non-pipeline features: plan, chat, graph) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_TIMEOUT_MS=180000
# VITE_NEON_AUTH_URL=            # legacy Neon Auth (unused by the pipeline)
