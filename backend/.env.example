# -- Neon Postgres -------------------------------------------------------------
# Target persistence layer for Milestone 5+.
DATABASE_URL=               # Neon pooled connection string
DATABASE_URL_UNPOOLED=      # Neon direct connection string for migrations

# -- Neon Auth ----------------------------------------------------------------
# Target auth layer. Client-facing Auth URL also belongs in frontend/.env.local.
NEON_AUTH_URL=              # https://ep-xxx.neonauth.../dbname/auth
NEON_AUTH_JWKS_URL=         # JWKS endpoint for backend JWT verification
NEON_AUTH_ISSUER=           # Optional expected JWT issuer
NEON_AUTH_AUDIENCE=         # Optional expected JWT audience
AUTH_REQUIRED=false         # Set true to require JWTs on protected /v1 routes

# Legacy Stack Auth names are still accepted by config during migration.
STACK_JWKS_URL=

# -- Markdown graph ------------------------------------------------------------
# Target graph source for Milestone 4.
GRAPH_SOURCE=markdown       # markdown | neo4j
GRAPH_DATA_DIR=../data/graph

# -- Legacy Neo4j adapter ------------------------------------------------------
# Optional during migration. The MVP target should run without these.
NEO4J_URI=                  # neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=             # neo4j
NEO4J_PASSWORD=             # AuraDB password

# -- AI providers --------------------------------------------------------------
# At least one AI provider is required for /v1/plan and /v1/bridge.
# Gemini is the default recommended path.
AI_PROVIDER=auto            # auto | gemini | groq | anthropic | rocketride_sdk | rocketride_http
GEMINI_API_KEY=             # https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.0-flash

# Groq: fast fallback for low-latency queries.
GROQ_API_KEY=               # https://console.groq.com

# Anthropic: optional paid fallback.
ANTHROPIC_API_KEY=

# -- Session cache -------------------------------------------------------------
# Neon app_sessions is the default persistence path; Upstash remains optional.
SESSION_TTL_HOURS=24
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# -- Email ---------------------------------------------------------------------
RESEND_API_KEY=             # https://resend.com/api-keys

# -- LinkedIn OAuth ------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/v1/auth/linkedin/callback

# -- RocketRide (optional legacy pipelines) -----------------------------------
ROCKETRIDE_URI=
ROCKETRIDE_APIKEY=
ROCKETRIDE_HTTP_COMPLETION_URL=

# -- Xano migration (M18+, hackathon build) -------------------------------------
# See docs/xano-document-pipeline-plan.md. Xano becomes the system of record for
# auth + 4 pipeline-adjacent tables; FastAPI becomes a stateless sidecar. Both
# vars are optional until the M18 Xano workspace exists -- unset, the sidecar
# behaves exactly as it does today (§ sidecar_auth.py docstring).
XANO_BASE_URL=              # Xano API group base URL
SIDECAR_SHARED_SECRET=      # Xano -> sidecar shared secret (X-Sidecar-Key header)

# -- Hackathon vendor APIs (M19) --------------------------------------------------
# Mock-first: every var below may stay unset and the pipeline still runs end to
# end against seeded vendor_fixtures rows in Xano. Set VENDOR_MODE=live (or a
# per-vendor override) once real sandbox keys arrive.
VENDOR_MODE=mock             # mock | live (global default)
NUTRIENT_MODE=               # per-vendor override of VENDOR_MODE
DOCTAVIAN_MODE=
SERPAPI_MODE=
FOXIT_MODE=
CONFIDENCE_THRESHOLD=0.85    # below this, an extracted I-20 field goes to human review
NUTRIENT_DWS_API_KEY=        # https://nutrient.io -- /extract + DWS Viewer
DOCTAVIAN_API_KEY=           # https://developers.doctavian.com -- document generation
SERPAPI_API_KEY=             # https://serpapi.com -- live policy/processing-time checks
FOXIT_PDF_SERVICES_CLIENT_ID=      # PDF Services MCP server, read before the MCP host launches
FOXIT_PDF_SERVICES_CLIENT_SECRET=  # separate credentials from eSign -- see docs §2.2
FOXIT_ESIGN_CLIENT_ID=             # eSign REST API -- OAuth2 client_credentials, outside the MCP server
FOXIT_ESIGN_CLIENT_SECRET=
FOXIT_WEBHOOK_SECRET=         # HMAC verification for POST /v1/webhooks/foxit (Xano-side)

# -- migrate_neon_to_xano.py (M18 one-shot data port, scripts/) -------------------
XANO_MIGRATION_TOKEN=        # bearer token for Xano's temporary migration API group

# -- CORS ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
